# По умолчанию - текст с нормализацией переводов строк
* text=auto eol=lf

# Shell-скрипты и конфиги - строго LF, иначе в Linux они не запустятся
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mjs text eol=lf
*.kts text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Бинарные файлы
*.jar binary
*.png binary
*.gif binary
*.zip binary
